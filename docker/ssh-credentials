#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail
umask 077
export LC_ALL=C

fail() {
    echo "ssh-credentials: $*" >&2
    exit 1
}

private_mode() {
    local path="$1" label="$2" mode
    mode="$(stat -c '%a' "${path}")"
    [[ "${mode}" =~ ^[0-7]{3,4}$ ]] || fail "could not read permissions for ${label}: ${path}"
    (( (8#${mode} & 077) == 0 )) || fail "${label} must not be accessible by group or others: ${path}"
}

regular_managed_file() {
    local path="$1" label="$2"
    [[ -f "${path}" && ! -L "${path}" ]] || fail "${label} must be a regular non-symlink file: ${path}"
    [[ "$(stat -c '%h' "${path}")" == 1 ]] || fail "${label} must not be hard-linked: ${path}"
}

validate_target() {
    local target="$1" user host label
    [[ "${target}" == *@* && "${target}" != *@*@* ]] || return 1
    user="${target%%@*}"
    host="${target#*@}"
    [[ "${user}" =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]] || return 1
    [[ ${#host} -le 253 && "${host}" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || return 1
    [[ "${host}" != *..* ]] || return 1
    IFS=. read -r -a labels <<< "${host}"
    for label in "${labels[@]}"; do
        [[ ${#label} -le 63 && "${label}" != -* && "${label}" != *- ]] || return 1
    done
}

configure() {
    local profile_input="${PI_RUN_PROFILE_DIR:-/profile}" profile_dir credentials_dir ssh_dir
    local runtime_ssh config temp path name target user host normalized i count=0
    local -a paths=() users=() hosts=()
    declare -A host_targets=()

    [[ -n "${HOME:-}" && -d "${HOME}" && ! -L "${HOME}" ]] \
        || fail "HOME must be a non-symlink directory"
    [[ -d "${profile_input}" ]] || fail "profile directory does not exist: ${profile_input}"
    profile_dir="$(realpath "${profile_input}")"
    credentials_dir="${profile_dir}/credentials"
    ssh_dir="${credentials_dir}/ssh"

    if [[ ! -e "${credentials_dir}" && ! -L "${credentials_dir}" ]]; then
        return 0
    fi
    [[ -d "${credentials_dir}" && ! -L "${credentials_dir}" ]] \
        || fail "credentials must be a non-symlink directory: ${credentials_dir}"
    if [[ ! -e "${ssh_dir}" && ! -L "${ssh_dir}" ]]; then
        return 0
    fi
    [[ -d "${ssh_dir}" && ! -L "${ssh_dir}" && "$(realpath "${ssh_dir}")" == "${ssh_dir}" ]] \
        || fail "SSH credentials must be a non-symlink directory: ${ssh_dir}"
    private_mode "${ssh_dir}" "SSH credential directory"

    shopt -s nullglob
    for path in "${ssh_dir}"/* "${ssh_dir}"/.[!.]* "${ssh_dir}"/..?*; do
        name="$(basename "${path}")"
        case "${name}" in
            known_hosts)
                regular_managed_file "${path}" "known_hosts"
                continue
                ;;
            *.pub)
                target="${name%.pub}"
                validate_target "${target}" || fail "unsafe SSH credential filename: ${name}"
                regular_managed_file "${path}" "public key"
                continue
                ;;
            *)
                validate_target "${name}" || fail "unsafe SSH credential filename: ${name}"
                regular_managed_file "${path}" "private key"
                private_mode "${path}" "private key"
                ssh-keygen -y -P '' -f "${path}" >/dev/null 2>&1 \
                    || fail "private key is invalid or encrypted: ${name}"
                target="${name}"
                user="${target%%@*}"
                host="${target#*@}"
                normalized="${host,,}"
                if [[ -n "${host_targets[${normalized}]:-}" ]]; then
                    fail "ambiguous SSH hostname ${host}: ${host_targets[${normalized}]} and ${target}"
                fi
                host_targets["${normalized}"]="${target}"
                paths+=("${path}")
                users+=("${user}")
                hosts+=("${host}")
                count=$((count + 1))
                ;;
        esac
    done
    shopt -u nullglob

    (( count > 0 )) || return 0
    runtime_ssh="${HOME}/.ssh"
    config="${runtime_ssh}/config"
    if [[ -e "${runtime_ssh}" || -L "${runtime_ssh}" ]]; then
        [[ -d "${runtime_ssh}" && ! -L "${runtime_ssh}" ]] \
            || fail "runtime SSH path must be a non-symlink directory: ${runtime_ssh}"
        private_mode "${runtime_ssh}" "runtime SSH directory"
    else
        mkdir -m 0700 "${runtime_ssh}"
    fi
    [[ ! -e "${config}" && ! -L "${config}" ]] \
        || fail "refusing to overwrite existing runtime SSH config: ${config}"

    temp="$(mktemp "${runtime_ssh}/.pi-run-config.XXXXXX")"
    trap 'rm -f "${temp:-}"' EXIT
    chmod 0600 "${temp}"
    {
        printf '# Generated by Pi-Run from profile SSH credentials.\n'
        for ((i = 0; i < count; i++)); do
            printf '\nHost %s\n' "${hosts[i]}"
            printf '    User %s\n' "${users[i]}"
            printf '    IdentityFile %s\n' "${paths[i]}"
            printf '    IdentitiesOnly yes\n'
            printf '    UserKnownHostsFile %s/known_hosts\n' "${ssh_dir}"
        done
    } > "${temp}"
    mv "${temp}" "${config}"
    trap - EXIT
}

safe_managed_file() {
    local path="$1"
    [[ -f "${path}" && ! -L "${path}" ]] || return 1
    [[ "$(stat -c '%h' "${path}")" == 1 ]]
}

safe_private_permissions() {
    local mode
    mode="$(stat -c '%a' "$1")"
    [[ "${mode}" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#${mode} & 077) == 0 ))
}

private_fingerprint() {
    local path="$1" public
    public="$(ssh-keygen -y -P '' -f "${path}" 2>/dev/null)" || return 1
    printf '%s\n' "${public}" | ssh-keygen -lf - 2>/dev/null | awk 'NR == 1 { print $2 }'
}

public_fingerprint() {
    local path="$1" record_count key_type key_data
    record_count="$(awk 'NF { count++ } END { print count + 0 }' "${path}")"
    [[ "${record_count}" == 1 ]] || return 1
    read -r key_type key_data < <(awk 'NF { print; exit }' "${path}")
    [[ "${key_type}" =~ ^(ssh-|ecdsa-|sk-) && -n "${key_data}" ]] || return 1
    ssh-keygen -lf "${path}" 2>/dev/null | awk 'NR == 1 { print $2 }'
}

list_keys() {
    local profile_input="${PI_RUN_PROFILE_DIR:-/profile}" profile_dir credentials_dir ssh_dir
    local path name target host normalized status fingerprint private_fp public_fp index
    local target_width=6 status_width=6
    local -a targets=() unsafe_names=() row_targets=() row_statuses=() row_fingerprints=()
    declare -A private_paths=() public_paths=() seen=() host_counts=()

    [[ -d "${profile_input}" ]] || fail "profile directory does not exist: ${profile_input}"
    profile_dir="$(realpath "${profile_input}")"
    credentials_dir="${profile_dir}/credentials"
    ssh_dir="${credentials_dir}/ssh"
    if [[ ! -e "${credentials_dir}" && ! -L "${credentials_dir}" ]]; then
        printf 'No SSH keys stored.\n'
        return 0
    fi
    [[ -d "${credentials_dir}" && ! -L "${credentials_dir}" ]] \
        || fail "credentials must be a non-symlink directory: ${credentials_dir}"
    if [[ ! -e "${ssh_dir}" && ! -L "${ssh_dir}" ]]; then
        printf 'No SSH keys stored.\n'
        return 0
    fi
    [[ -d "${ssh_dir}" && ! -L "${ssh_dir}" && "$(realpath "${ssh_dir}")" == "${ssh_dir}" ]] \
        || fail "SSH credentials must be a non-symlink directory: ${ssh_dir}"
    private_mode "${ssh_dir}" "SSH credential directory"

    shopt -s nullglob
    for path in "${ssh_dir}"/* "${ssh_dir}"/.[!.]* "${ssh_dir}"/..?*; do
        name="$(basename "${path}")"
        if [[ "${name}" == known_hosts ]]; then
            safe_managed_file "${path}" || unsafe_names+=("known_hosts")
        elif [[ "${name}" == *.pub ]]; then
            target="${name%.pub}"
            if ! validate_target "${target}" || ! safe_managed_file "${path}"; then
                unsafe_names+=("${name}")
            else
                public_paths["${target}"]="${path}"
                seen["${target}"]=1
            fi
        else
            target="${name}"
            if ! validate_target "${target}" || ! safe_managed_file "${path}" ||
                ! safe_private_permissions "${path}"; then
                unsafe_names+=("${name}")
            else
                private_paths["${target}"]="${path}"
                seen["${target}"]=1
            fi
        fi
    done
    shopt -u nullglob

    if (( ${#seen[@]} > 0 )); then
        mapfile -t targets < <(printf '%s\n' "${!seen[@]}" | sort)
        for target in "${targets[@]}"; do
            host="${target#*@}"
            normalized="${host,,}"
            host_counts["${normalized}"]=$(( ${host_counts[${normalized}]:-0} + 1 ))
        done
    fi
    if (( ${#unsafe_names[@]} > 0 )); then
        mapfile -t unsafe_names < <(printf '%s\n' "${unsafe_names[@]}" | sort -u)
    fi
    if (( ${#targets[@]} == 0 && ${#unsafe_names[@]} == 0 )); then
        printf 'No SSH keys stored.\n'
        return 0
    fi

    for name in "${unsafe_names[@]}"; do
        row_targets+=("${name}")
        row_statuses+=(unsafe-entry)
        row_fingerprints+=(-)
    done
    for target in "${targets[@]}"; do
        private_fp=""
        public_fp=""
        if [[ -n "${private_paths[${target}]:-}" ]]; then
            private_fp="$(private_fingerprint "${private_paths[${target}]}" || true)"
        fi
        if [[ -n "${public_paths[${target}]:-}" ]]; then
            public_fp="$(public_fingerprint "${public_paths[${target}]}" || true)"
        fi

        if [[ -n "${private_paths[${target}]:-}" && -n "${public_paths[${target}]:-}" ]]; then
            if [[ -z "${private_fp}" ]]; then
                status="invalid-or-encrypted-private"
                fingerprint="${public_fp:--}"
            elif [[ -z "${public_fp}" ]]; then
                status="invalid-public"
                fingerprint="${private_fp}"
            elif [[ "${private_fp}" != "${public_fp}" ]]; then
                status="mismatched-pair"
                fingerprint="${private_fp}/${public_fp}"
            else
                status="valid"
                fingerprint="${private_fp}"
            fi
        elif [[ -n "${private_paths[${target}]:-}" ]]; then
            if [[ -n "${private_fp}" ]]; then
                status="private-only"
                fingerprint="${private_fp}"
            else
                status="invalid-or-encrypted-private"
                fingerprint="-"
            fi
        else
            if [[ -n "${public_fp}" ]]; then
                status="public-only"
                fingerprint="${public_fp}"
            else
                status="invalid-public"
                fingerprint="-"
            fi
        fi

        normalized="${target#*@}"
        normalized="${normalized,,}"
        if (( ${host_counts[${normalized}]} > 1 )); then
            status="ambiguous-host:${status}"
        fi
        row_targets+=("${target}")
        row_statuses+=("${status}")
        row_fingerprints+=("${fingerprint}")
    done

    for index in "${!row_targets[@]}"; do
        (( ${#row_targets[index]} > target_width )) && target_width=${#row_targets[index]}
        (( ${#row_statuses[index]} > status_width )) && status_width=${#row_statuses[index]}
    done
    printf '%-*s  %-*s  %s\n' "${target_width}" TARGET "${status_width}" STATUS FINGERPRINT
    for index in "${!row_targets[@]}"; do
        printf '%-*s  %-*s  %s\n' \
            "${target_width}" "${row_targets[index]}" \
            "${status_width}" "${row_statuses[index]}" \
            "${row_fingerprints[index]}"
    done
}

add_key() {
    local target="$1" profile_input="${PI_RUN_PROFILE_DIR:-/profile}" profile_dir
    local credentials_dir ssh_dir private public known_hosts runtime_ssh path name existing host
    local private_fp public_fp staging generated=false status

    validate_target "${target}" || fail "invalid SSH target: ${target}"
    [[ -n "${HOME:-}" && -d "${HOME}" && ! -L "${HOME}" ]] \
        || fail "HOME must be a non-symlink directory"
    [[ -d "${profile_input}" ]] || fail "profile directory does not exist: ${profile_input}"
    profile_dir="$(realpath "${profile_input}")"
    credentials_dir="${profile_dir}/credentials"
    ssh_dir="${credentials_dir}/ssh"
    private="${ssh_dir}/${target}"
    public="${private}.pub"
    known_hosts="${ssh_dir}/known_hosts"

    if [[ -e "${credentials_dir}" || -L "${credentials_dir}" ]]; then
        [[ -d "${credentials_dir}" && ! -L "${credentials_dir}" ]] \
            || fail "credentials must be a non-symlink directory: ${credentials_dir}"
        private_mode "${credentials_dir}" "credential directory"
    else
        mkdir -m 0700 "${credentials_dir}"
    fi
    if [[ -e "${ssh_dir}" || -L "${ssh_dir}" ]]; then
        [[ -d "${ssh_dir}" && ! -L "${ssh_dir}" && "$(realpath "${ssh_dir}")" == "${ssh_dir}" ]] \
            || fail "SSH credentials must be a non-symlink directory: ${ssh_dir}"
        private_mode "${ssh_dir}" "SSH credential directory"
    else
        mkdir -m 0700 "${ssh_dir}"
    fi
    if [[ -e "${known_hosts}" || -L "${known_hosts}" ]]; then
        safe_managed_file "${known_hosts}" \
            || fail "known_hosts must be a regular, non-linked file: ${known_hosts}"
    fi

    host="${target#*@}"
    shopt -s nullglob
    for path in "${ssh_dir}"/* "${ssh_dir}"/.[!.]* "${ssh_dir}"/..?*; do
        name="$(basename "${path}")"
        [[ "${name}" != known_hosts && "${name}" != *.pub && "${name}" != "${target}" ]] || continue
        if validate_target "${name}"; then
            existing="${name#*@}"
            [[ "${existing,,}" != "${host,,}" ]] \
                || fail "SSH hostname ${host} already has target ${name}"
        fi
    done
    shopt -u nullglob

    if { [[ -e "${private}" || -L "${private}" ]] &&
         [[ ! -e "${public}" && ! -L "${public}" ]]; } ||
       { [[ ! -e "${private}" && ! -L "${private}" ]] &&
         [[ -e "${public}" || -L "${public}" ]]; }; then
        fail "SSH key pair is incomplete: ${target}"
    fi
    if [[ -e "${private}" || -L "${private}" ]]; then
        safe_managed_file "${private}" || fail "private key is not a safe regular file: ${private}"
        safe_private_permissions "${private}" || fail "private key permissions are unsafe: ${private}"
        safe_managed_file "${public}" || fail "public key is not a safe regular file: ${public}"
        private_fp="$(private_fingerprint "${private}" || true)"
        [[ -n "${private_fp}" ]] || fail "private key is invalid or encrypted: ${target}"
        public_fp="$(public_fingerprint "${public}" || true)"
        [[ -n "${public_fp}" ]] || fail "public key is invalid: ${target}"
        [[ "${private_fp}" == "${public_fp}" ]] || fail "SSH key pair does not match: ${target}"
        printf 'Reusing SSH key pair for %s.\n' "${target}"
    else
        staging="$(mktemp -d "${ssh_dir}/.pi-run-key.XXXXXX")"
        ADD_STAGING="${staging}"
        ADD_PUBLIC="${public}"
        ADD_PUBLIC_CREATED=false
        ADD_PRIVATE_CREATED=false
        trap 'rm -rf "${ADD_STAGING:-}"; if [[ "${ADD_PUBLIC_CREATED:-false}" == true && "${ADD_PRIVATE_CREATED:-false}" != true ]]; then rm -f "${ADD_PUBLIC:-}"; fi' EXIT
        ssh-keygen -q -t ed25519 -N '' -C "${target}" -f "${staging}/key"
        chmod 0600 "${staging}/key"
        chmod 0644 "${staging}/key.pub"
        ln "${staging}/key.pub" "${public}" || fail "SSH public key appeared during generation: ${public}"
        ADD_PUBLIC_CREATED=true
        ln "${staging}/key" "${private}" || fail "SSH private key appeared during generation: ${private}"
        ADD_PRIVATE_CREATED=true
        rm -rf "${staging}"
        trap - EXIT
        generated=true
        printf 'Generated SSH key pair for %s.\n' "${target}"
    fi

    runtime_ssh="${HOME}/.ssh"
    if [[ -e "${runtime_ssh}" || -L "${runtime_ssh}" ]]; then
        [[ -d "${runtime_ssh}" && ! -L "${runtime_ssh}" ]] \
            || fail "runtime SSH path must be a non-symlink directory: ${runtime_ssh}"
        private_mode "${runtime_ssh}" "runtime SSH directory"
    else
        mkdir -m 0700 "${runtime_ssh}"
    fi

    set +e
    ssh-copy-id \
        -i "${public}" \
        -o "UserKnownHostsFile=${known_hosts}" \
        -o StrictHostKeyChecking=ask \
        -o IdentitiesOnly=yes \
        "${target}"
    status=$?
    set -e
    if (( status != 0 )); then
        printf 'SSH public-key installation failed; key pair retained for %s.\n' "${target}" >&2
        return "${status}"
    fi
    if [[ "${generated}" == true ]]; then
        printf 'Generated key installed for %s.\n' "${target}"
    else
        printf 'Existing key installed or already present for %s.\n' "${target}"
    fi
}

remove_key() {
    local target="$1" profile_input="${PI_RUN_PROFILE_DIR:-/profile}" profile_dir
    local credentials_dir ssh_dir private public response

    validate_target "${target}" || fail "invalid SSH target: ${target}"
    [[ -d "${profile_input}" ]] || fail "profile directory does not exist: ${profile_input}"
    profile_dir="$(realpath "${profile_input}")"
    credentials_dir="${profile_dir}/credentials"
    ssh_dir="${credentials_dir}/ssh"
    private="${ssh_dir}/${target}"
    public="${private}.pub"

    if [[ ! -e "${credentials_dir}" && ! -L "${credentials_dir}" ]]; then
        printf 'No local SSH key files found for %s.\n' "${target}"
        return 0
    fi
    [[ -d "${credentials_dir}" && ! -L "${credentials_dir}" ]] \
        || fail "credentials must be a non-symlink directory: ${credentials_dir}"
    if [[ ! -e "${ssh_dir}" && ! -L "${ssh_dir}" ]]; then
        printf 'No local SSH key files found for %s.\n' "${target}"
        return 0
    fi
    [[ -d "${ssh_dir}" && ! -L "${ssh_dir}" && "$(realpath "${ssh_dir}")" == "${ssh_dir}" ]] \
        || fail "SSH credentials must be a non-symlink directory: ${ssh_dir}"
    if [[ ! -e "${private}" && ! -L "${private}" &&
          ! -e "${public}" && ! -L "${public}" ]]; then
        printf 'No local SSH key files found for %s.\n' "${target}"
        return 0
    fi
    [[ ! -d "${private}" || -L "${private}" ]] \
        || fail "refusing to remove a directory as a private key: ${private}"
    [[ ! -d "${public}" || -L "${public}" ]] \
        || fail "refusing to remove a directory as a public key: ${public}"

    printf 'Remove local SSH key files for %s? [y/N] ' "${target}" >&2
    IFS= read -r response || response=""
    case "${response,,}" in
        y|yes) ;;
        *)
            printf 'Removal cancelled for %s.\n' "${target}" >&2
            return 1
            ;;
    esac

    rm -f -- "${private}" "${public}"
    printf 'Removed local SSH key files for %s.\n' "${target}"
    printf 'Remote authorized_keys was not changed.\n'
}

usage_error() {
    fail "usage: ssh-credentials <configure|list|add target|remove target>"
}

case "${1:-}" in
    configure|list)
        [[ $# -eq 1 ]] || usage_error
        if [[ "$1" == configure ]]; then
            configure
        else
            list_keys
        fi
        ;;
    add|remove)
        [[ $# -eq 2 ]] || usage_error
        if [[ "$1" == add ]]; then
            add_key "$2"
        else
            remove_key "$2"
        fi
        ;;
    *) usage_error ;;
esac
