{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprilsoftware.com/pi-run/schemas/factory-task-v1.schema.json",
  "title": "Pi-Run Factory Task Contract v1",
  "description": "One exact, human-selected local software-factory task revision. Schema validity is not approval or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "revision",
    "createdAt",
    "repository",
    "managedTaskName",
    "profile",
    "networkMode",
    "goal",
    "acceptanceCriteria",
    "allowedEffects",
    "exclusions",
    "validations",
    "limits",
    "desiredOutcome",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "baseCommit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[ -~]*$"
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "managedTaskName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "networkMode": {
      "enum": [
        "host",
        "offline",
        "restricted"
      ]
    },
    "goal": {
      "$ref": "#/$defs/longText"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/shortText"
      }
    },
    "allowedEffects": {
      "type": "array",
      "prefixItems": [
        {
          "const": "modify-managed-worktree"
        },
        {
          "const": "run-declared-validation"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/shortText"
      }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxIterations",
        "maxDurationSeconds",
        "maxFailures",
        "maxNoProgress"
      ],
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "maxFailures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "maxNoProgress": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "desiredOutcome": {
      "const": "validated-local-worktree"
    },
    "provenance": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/provenance"
      }
    }
  },
  "$defs": {
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "argument": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv",
        "timeoutSeconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "plan",
            "issue",
            "repository-file",
            "other"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    }
  }
}
